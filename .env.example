# ==============================================================================
# Pollux Polyglot JVM — Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your `.env` file to version control.
# ==============================================================================

# Sonatype Maven Central Portal / OSSRH User Token
# Generate at: https://central.sonatype.com/account or https://s01.oss.sonatype.org/
MAVEN_CENTRAL_USERNAME=
MAVEN_CENTRAL_PASSWORD=

# GPG Signing Credentials (Mandatory for Maven Central releases)
# SIGNING_SECRET_KEY: Exported ASCII-armored private GPG key:
#   gpg --armor --export-secret-keys YOUR_KEY_ID
# SIGNING_PASSWORD: Passphrase used when generating the GPG key
SIGNING_KEY_ID=
SIGNING_PASSWORD=
SIGNING_SECRET_KEY=
